# Copy to .env and fill in one key. Groq free tier needs no credit card.
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=
OPENROUTER_API_KEY=

TOP_SCORE_THRESHOLD=0.4
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=700
CHUNK_SIZE=300
CHUNK_OVERLAP=50

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
INGEST_ADMIN_KEY=change-me
